GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Required only for PDF upload.
S3_BUCKET=your-private-bucket
AWS_REGION=us-east-1
S3_PREFIX=pdfs

CORS_ORIGINS=http://localhost:5173

# Shared session memory and durable LangGraph checkpoints.
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400
SESSION_MAX_MESSAGES=50
RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT=30
ANALYZE_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=10
CHAT_LOCK_TTL_SECONDS=120
ANALYZE_LOCK_TTL_SECONDS=1800
QUERY_EMBEDDING_CACHE_TTL_SECONDS=604800
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
LANGGRAPH_STRICT_MSGPACK=true

# Supabase Data API. Use values printed by `npx supabase status` locally.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
